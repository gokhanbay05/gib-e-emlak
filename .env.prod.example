# GİB e-Emlak — Üretim (NAS) Ortam Değişkenleri Şablonu
# Bu dosyayı '.env.prod' olarak kopyalayıp değerleri doldurun (Git'e göndermeyin!).

# GitHub Container Registry sahibi (küçük harf) ve imaj etiketi
GHCR_OWNER=gokhanbay05
IMAGE_TAG=latest

# PostgreSQL Veritabanı (Güçlü bir şifre belirleyin)
POSTGRES_USER=gib_user
POSTGRES_PASSWORD=BURAYA_GUCLU_DB_SIFRESI_YAZIN
POSTGRES_DB=gib_emlak_db

# Cloudflare Zero Trust Tunnel Token (Networks -> Tunnels -> Configure ekranından alınır)
CLOUDFLARE_TUNNEL_TOKEN=BURAYA_CLOUDFLARE_TUNNEL_TOKEN_YAZIN

# Watchtower kontrol aralığı (saniye cinsinden; varsayılan 300 = 5 dakika)
WATCHTOWER_POLL_INTERVAL=300

# Opsiyonel: Özel alan adınız (Nginx aynı origin'den sunduğu için boş kalabilir)
CORS_ORIGINS=https://emlak.ornekdomain.com

# Opsiyonel: Sadece '--profile tools' ile açılan yerel pgAdmin bilgileri
PGADMIN_DEFAULT_EMAIL=admin@gibemlak.com
PGADMIN_DEFAULT_PASSWORD=BURAYA_PGADMIN_SIFRESI_YAZIN
